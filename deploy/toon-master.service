# The public server list (master) every game finds servers through.
# Copy to /etc/systemd/system/toon-master.service, then:
#   sudo systemctl enable --now toon-master
# It listens on TCP 27900 on this machine. Publish it as https://master.pagani.com.ua (the
# address in toon_shared::consts::MASTER_DEFAULT): through a Cloudflare tunnel to
# http://localhost:27900, or behind nginx/Caddy with HTTPS.
[Unit]
Description=Toon Warfare public server list
After=network-online.target
Wants=network-online.target

[Service]
User=toon
WorkingDirectory=/opt/toon
ExecStart=/opt/toon/toon-server --master 27900
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
