# The public server list (master) every game finds servers through.
# Copy to /etc/systemd/system/toon-master.service, then:
#   sudo systemctl enable --now toon-master
# It listens on TCP 27900: open it (sudo ufw allow 27900/tcp) and point the DNS name in
# toon_shared::consts::MASTER_DEFAULT (master.pagani.com.ua) at this machine.
[Unit]
Description=Toon Warfare public server list
After=network-online.target
Wants=network-online.target

[Service]
User=toon
WorkingDirectory=/opt/toon
ExecStart=/opt/toon/toon-server --master 27900
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
